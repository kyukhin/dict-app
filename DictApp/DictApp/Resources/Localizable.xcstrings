    "dictionaryInfo.direction.value %@ %@": {
      "comment": "Translation direction, source language then target language. Arabic uses ← (U+2190) because → is not mirrored in right-to-left text. ar: leading U+200F (RLM) makes the line right-to-left; Foundation isolates each argument, so without it the line lays out left-to-right (#119). Every RTL language needs it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ → %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ → %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ → %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u200F%1$@ ← %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ → %2$@"
          }
        }
      }
    },
