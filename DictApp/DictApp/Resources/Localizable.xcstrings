    "settings.licenseNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app uses data from public-domain and openly licensed dictionary projects. Each dictionary retains its original license."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение использует данные из словарных проектов, распространяемых под открытыми лицензиями и в общественном достоянии. Каждый словарь сохраняет свою исходную лицензию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aplicación utiliza datos de proyectos de diccionarios de dominio público y con licencia abierta. Cada diccionario conserva su licencia original."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم هذا التطبيق بيانات من مشاريع قواميس في الملك العام وبتراخيص مفتوحة. يحتفظ كل قاموس بترخيصه الأصلي."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή χρησιμοποιεί δεδομένα από έργα λεξικών που ανήκουν στον δημόσιο τομέα ή διατίθενται με ανοιχτές άδειες χρήσης. Κάθε λεξικό διατηρεί την αρχική του άδεια χρήσης."
          }
        }
      }
    },
