    "sourceBadge.accessibilityLabel.pair %@ %@ %@": {
      "comment": "VoiceOver label of a search-result source badge: source language, target language (nominative language names), then the provider brand (FreeDict, WordNet, OpenRussian). No arrows: VoiceOver reads them as \"right arrow\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to %2$@, %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, %3$@"
          }
        },
        "es": {
