    "newWordsFrom.header": {
      "comment": "New words from: the text at the top.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower levels come first: A1, then A2 and up. Lists without levels come last."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала идут нижние уровни: A1, затем A2 и выше. Списки без уровней идут последними."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero van los niveles más bajos: A1, luego A2 y los siguientes. Las listas sin niveles van al final."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي المستويات الأدنى أولًا: A1، ثم A2 وما فوقه. وتأتي القوائم التي بلا مستويات في النهاية."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρώτα έρχονται τα χαμηλότερα επίπεδα: Α1, μετά Α2 και πάνω. Οι λίστες χωρίς επίπεδα έρχονται τελευταίες."
          }
        }
      }
    },
    "newWordsFrom.none": {
      "comment": "New words from: the footer while no list is checked.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No list checked. New words come only from words you add with Learn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один список не отмечен. Новые слова берутся только из слов, добавленных кнопкой «Учить»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna lista marcada. Las palabras nuevas solo salen de las que añades con Aprender."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحدَّد أي قائمة. تأتي الكلمات الجديدة فقط من الكلمات التي تضيفها بزر «تعلّم»."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει επιλεγεί λίστα. Οι νέες λέξεις έρχονται μόνο από όσες προσθέτετε με το «Μάθηση»."
          }
        }
      }
    },
