          "stringUnit": {
            "state": "translated",
            "value": "\u200Fيمكنك مواصلة تعلّم الكلمات التي لديك. تعود قوائم %1$@ عندما تنزّل %2$@ مرة أخرى."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να συνεχίσετε να μαθαίνετε τις λέξεις που έχετε. Οι λίστες (%1$@) επιστρέφουν όταν κατεβάσετε ξανά τα %2$@."
          }
        }
      }
    },
    "languages.remove.learning.noLists": {
