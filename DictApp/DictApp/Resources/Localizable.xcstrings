    "welcome.upgrade.body": {
      "comment": "First-launch sheet after an update from 1.x or the 2.0 alpha: under the title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LibreDict 2.0 downloads languages other than English once. Your History and My words are here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LibreDict 2.0 один раз скачивает языки, кроме английского. Ваша история и «Мои слова» на месте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LibreDict 2.0 descarga una vez los idiomas distintos del inglés. Tu historial y Mis palabras siguen aquí."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنزّل LibreDict 2.0 اللغات غير الإنجليزية مرة واحدة. سجلك وكلماتي هنا."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το LibreDict 2.0 κατεβάζει μία φορά τις γλώσσες εκτός από τα Αγγλικά. Το Ιστορικό και οι λέξεις μου είναι εδώ."
          }
        }
      }
