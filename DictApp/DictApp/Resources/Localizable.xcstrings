    "languages.remove.learning %@ %@": {
      "comment": "Remove alert, when the language is being learned. Both arguments are the language's name inside a sentence (lower case except in English). ar: leading U+200F (RLM) makes the line right-to-left (#119).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can go on learning the words you have. %1$@ lists come back when you download %2$@ again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете дальше учить слова, которые у вас есть. Списки слов (%1$@) вернутся, когда вы снова скачаете %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seguir aprendiendo las palabras que ya tienes. Las listas de %1$@ vuelven cuando descargues %2$@ de nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u200Fيمكنك مواصلة تعلّم الكلمات التي لديك. تعود قوائم %1$@ عندما تنزّل %2$@ مرة أخرى."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να συνεχίσετε να μαθαίνετε τις λέξεις που έχετε. Οι λίστες (%1$@) επιστρέφουν όταν κατεβάσετε ξανά τα %2$@."
          }
        }
      }
    },
    "languages.remove.learning.noLists": {
      "comment": "Remove alert, when the language is being learned and has no built-in word lists (Spanish, Russian, Arabic).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can go on learning the words you have."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете дальше учить слова, которые у вас есть."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seguir aprendiendo las palabras que ya tienes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك مواصلة تعلّم الكلمات التي لديك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να συνεχίσετε να μαθαίνετε τις λέξεις που έχετε."
          }
        }
      }
    },
    "languages.remove.message": {
      "comment": "Remove alert: what is deleted and what stays.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its dictionaries, word forms and word lists are deleted. Your History, My words and learning progress stay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его словари, формы слов и списки слов будут удалены. История, «Мои слова» и прогресс обучения сохранятся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán sus diccionarios, formas de las palabras y listas de palabras. Tu historial, Mis palabras y tu progreso de aprendizaje se conservan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف قواميسها وصيغ كلماتها وقوائم كلماتها. يبقى سجلك وكلماتي وتقدّمك في التعلّم."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα λεξικά, οι μορφές λέξεων και οι λίστες λέξεων της γλώσσας διαγράφονται. Το Ιστορικό, οι λέξεις μου και η πρόοδος εκμάθησης παραμένουν."
          }
        }
      }
    },
    "languages.remove.message.dictionaries": {
      "comment": "Remove alert of a language whose pack holds dictionaries only: what is deleted and what stays.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its dictionaries are deleted. Your History, My words and learning progress stay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его словари будут удалены. История, «Мои слова» и прогресс обучения сохранятся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán sus diccionarios. Tu historial, Mis palabras y tu progreso de aprendizaje se conservan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف قواميسها. يبقى سجلك وكلماتي وتقدّمك في التعلّم."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα λεξικά της γλώσσας διαγράφονται. Το Ιστορικό, οι λέξεις μου και η πρόοδος εκμάθησης παραμένουν."
          }
        }
      }
    },
