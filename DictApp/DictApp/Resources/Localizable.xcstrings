    "pack.error.stopped": {
      "comment": "A language download whose connection dropped.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download stopped. Check your connection and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка прервалась. Проверьте подключение и попробуйте ещё раз."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga se detuvo. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف التنزيل. تحقّق من اتصالك وحاول مرة أخرى."
