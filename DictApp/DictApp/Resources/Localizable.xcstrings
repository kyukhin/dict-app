    "forms.caption %@ %@": {
      "comment": "Search: caption under a row found as an inflected form of its headword, e.g. \"aorist 1sg of γράφω\". %1$@: the form's labels (tense, person, case…), %2$@: the lemma, a Greek word. ar: leading U+200F (RLM) makes the line right-to-left; Foundation isolates each argument, so without it the line lays out left-to-right (#119). Every RTL language needs it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ от %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u200F%1$@ من %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ του %2$@"
          }
        }
      }
    },
