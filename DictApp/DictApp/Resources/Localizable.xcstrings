    "listImport.help.columns": {
      "comment": "Formats help: the column names a header may use. Keep the English column names as they are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A header can name the columns term, translation, level, endings, part of speech and tags, or by language, such as greek and english. Without a header, the first column is the word and the second its translation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В заголовке столбцы можно назвать term, translation, level, endings, part of speech и tags или по языку, например greek и english. Без заголовка первый столбец — слово, второй — его перевод."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El encabezado puede llamar a las columnas term, translation, level, endings, part of speech y tags, o por idioma, como greek y english. Sin encabezado, la primera columna es la palabra y la segunda su traducción."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لسطر العناوين تسمية الأعمدة term وtranslation وlevel وendings وpart of speech وtags، أو باسم اللغة مثل greek وenglish. من دون سطر عناوين، يكون العمود الأول الكلمة والثاني ترجمتها."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επικεφαλίδα μπορεί να ονομάζει τις στήλες term, translation, level, endings, part of speech και tags, ή με τη γλώσσα, όπως greek και english. Χωρίς επικεφαλίδα, η πρώτη στήλη είναι η λέξη και η δεύτερη η μετάφρασή της."
          }
        }
      }
    },
