    "pack.error.noSpace %@ %@": {
      "comment": "A language download on a full disk: the row's name, then the space it needs (download and install). ar: leading U+200F (RLM) makes the line right-to-left (#119).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough storage. %1$@ needs %2$@ free."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно места. Для «%1$@» нужно %2$@ свободного места."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio. %1$@ necesita %2$@ libres."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u200Fلا توجد مساحة كافية. تحتاج %1$@ إلى %2$@ من المساحة الفارغة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει αρκετός χώρος. Απαιτούνται %2$@ ελεύθερα για: %1$@."
          }
        }
      }
    },
